# Server
PORT=5000
NODE_ENV=development

# Origin allowed to call the API with credentials (the Vite dev server in development).
CLIENT_ORIGIN=http://localhost:5173

# MongoDB connection string (Atlas or local). Use "memory" to run an in-process
# MongoDB (mongodb-memory-server) — handy for evaluation, data is discarded on exit.
MONGODB_URI=mongodb://127.0.0.1:27017/wellnest

# Secret used to sign session JWTs. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Google Gemini — clinical assessment generation
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# AssemblyAI — dictation transcription (optional)
ASSEMBLYAI_API_KEY=
